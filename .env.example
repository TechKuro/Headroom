# ── Headroom multi-user configuration ───────────────────────────────────────
# Copy to `.env` for local dev, or set these in the hosting project.
# Headroom is cloud-only: all plans live in the database behind /api, so dev
# needs the serverless API + DATABASE_URL (e.g. `vercel dev`), not just `vite`.
# Sign-in mode is chosen by whether the VITE_AZURE_* vars are set:
#   - ABSENT  → shared no-login mode (display name; server must set ALLOW_ANONYMOUS=1)
#   - SET     → Microsoft 365 (Entra) single sign-on

# ── Frontend (bundled by Vite — must be VITE_ prefixed) ──────────────────────
# Entra app registration (SPA platform) client + tenant IDs.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# The exposed API scope the SPA requests an access token for.
# e.g. api://<client-id>/access_as_user
VITE_AZURE_API_SCOPE=

# ── Backend (serverless functions) ──────────────────────────────────────────
# Auto-set by the Vercel Neon Marketplace integration.
DATABASE_URL=
# Token validation — same IDs as above (no VITE_ prefix, server-side only).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
